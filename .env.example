# 백엔드 API 서버 주소 (예: https://api.example.com)
API_BASE_URL='서버 주소'

# 카카오 맵 키
KAKAO_MAP_KEY=YOUR_KAKAO_MAP_KEY_HERE

# Supabase (Project Settings → API)
SUPABASE_URL=https://otjvbmrnawzvnnszhmmw.supabase.co
# anon(public) 키 또는 publishable 키 — service_role 키는 절대 넣지 말 것
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google OAuth 클라이언트 ID (Google Cloud Console → 사용자 인증 정보)
# 웹 클라이언트 ID: Android idToken 발급(serverClientId)에 필요, Supabase Google provider에도 등록
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
